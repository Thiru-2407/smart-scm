# =============================================================================
# Smart SCM - Backend Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT FOR PRODUCTION (Render Deployment):
#   Configure these variables in your Render Dashboard (Environment Settings).
#   NEVER commit .env files with real credentials to source control.
# =============================================================================

# Server Port & Host Binding
# Render automatically sets PORT in production; local fallback is 5000.
PORT=5000
HOST=0.0.0.0

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, Local MongoDB in Development)
# Local development example:
MONGO_URI=mongodb://127.0.0.1:27017/smart_scm
# Production (MongoDB Atlas) example:
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/smart_scm?retryWrites=true&w=majority

# JWT Authentication Configuration
# Generate a strong random 32+ character string in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_security
JWT_EXPIRE=24h

# CORS Configuration (Allowed Frontend Origins)
# Set to your deployed Vercel URL in production (e.g. https://smart-scm.vercel.app)
# Multiple origins can be comma-separated: https://smart-scm.vercel.app,https://smart-scm-preview.vercel.app
# Localhost origins (http://localhost:3000, http://127.0.0.1:3000) are allowed by default in development.
FRONTEND_URL=http://localhost:3000

# Unity Version Control (UVCS) Configuration [Optional]
# On Windows development machines with Plastic SCM / UVCS installed, these auto-detect.
# Leave blank or unconfigured in Linux cloud environments (Render) where UVCS is not installed.
# CM_PATH=C:\Program Files\PlasticSCM5\client\cm.exe
# UVCS_WORKSPACE_PATH=
